#include "resource.h"
#pragma code_page(65001)
#include "afxres.h"
LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT
IDR_MAINFRAME ICON "res\\arp.ico"

IDD_ARP_DIALOG DIALOGEX 0, 0, 420, 296
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "6주차 · Basic ARP"
FONT 9, "맑은 고딕", 0, 0, 0x1
BEGIN
    GROUPBOX        "ARP Cache",IDC_STATIC,10,10,400,173
    CONTROL         "",IDC_CACHE,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,19,24,382,126
    PUSHBUTTON      "선택 삭제",IDC_DELETE,19,159,70,15
    PUSHBUTTON      "전체 삭제",IDC_CLEAR,96,159,70,15
    LTEXT           "대상 IP",IDC_STATIC,12,195,43,10
    EDITTEXT        IDC_TARGET_IP,57,192,142,17,ES_AUTOHSCROLL
    PUSHBUTTON      "ARP 요청",IDC_REQUEST,210,192,82,17
    LTEXT           "어댑터",IDC_STATIC,12,221,43,10
    COMBOBOX        IDC_ADAPTER,57,218,255,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "연결",IDC_CONNECT,321,218,80,17
    LTEXT           "자기 MAC",IDC_STATIC,12,247,43,10
    EDITTEXT        IDC_SELF_MAC,57,244,142,17,ES_AUTOHSCROLL
    LTEXT           "자기 IP",IDC_STATIC,210,247,37,10
    EDITTEXT        IDC_SELF_IP,250,244,91,17,ES_AUTOHSCROLL
    PUSHBUTTON      "주소 적용",IDC_CONFIGURE,347,244,54,17
    LTEXT           "어댑터 연결 → 자기 MAC/IP 입력 → 주소 적용",IDC_STATUS,12,277,396,10
END
