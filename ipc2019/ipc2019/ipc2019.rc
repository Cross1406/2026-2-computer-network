/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ipc2019 정보"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "ipc2019, 버전 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2022",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "확인",IDOK,113,41,50,14,WS_GROUP
END

IDD_IPC2019_DIALOG DIALOGEX 0, 0, 320, 276
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LISTBOX         IDC_LIST_CHAT,7,7,190,115,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_SRC,219,24,94,15,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_DST,220,59,93,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_MSG,7,140,190,14,ES_AUTOHSCROLL
    PUSHBUTTON      "send",IDC_BUTTON_SEND,206,140,36,14
    PUSHBUTTON      "설정",IDC_BUTTON_ADDR,233,100,67,16
    CONTROL         "Broadcast Mode",IDC_CHECK_TOALL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,223,80,69,10
    LTEXT           "Source Address",IDC_STATIC,220,15,93,9
    LTEXT           "Destination Address",IDC_STATIC,220,47,93,9
    LTEXT           "Network Adapter",IDC_STATIC,7,165,90,9
    COMBOBOX        IDC_COMBO_ADAPTER,7,176,235,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "연결",IDC_BUTTON_ADAPTER_CONNECT,250,176,55,14
    LTEXT           "File Transfer",IDC_STATIC,7,202,90,9
    EDITTEXT        IDC_EDIT_FILE_PATH,7,213,235,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "파일 선택",IDC_BUTTON_FILE_BROWSE,250,213,55,14
    LTEXT           "상태: Ready",IDC_STATIC_FILE_STATUS,7,232,235,10
    LTEXT           "송신",IDC_STATIC,7,247,25,9
    CONTROL         "",IDC_PROGRESS_FILE_SEND,"msctls_progress32",PBS_SMOOTH,35,245,207,12
    LTEXT           "수신",IDC_STATIC,7,262,25,9
    CONTROL         "",IDC_PROGRESS_FILE_RECEIVE,"msctls_progress32",PBS_SMOOTH,35,260,207,12
    PUSHBUTTON      "파일 전송",IDC_BUTTON_FILE_SEND,250,245,55,27
END


